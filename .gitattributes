# Unity serializes many asset files with formatting that trips git whitespace checks.
psycho_unity_client/**/*.mat -whitespace
psycho_unity_client/**/*.meta -whitespace
psycho_unity_client/**/*.unity -whitespace
psycho_unity_client/ProjectSettings/*.asset -whitespace
psycho_unity_client/ProjectSettings/*.json -whitespace

# Required binary/vendor/runtime assets live in Git LFS instead of regular Git blobs.
*.7z filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text
*.idx filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
psycho_unity_client/Assets/Resources/PsychoMaterials/*.png filter=lfs diff=lfs merge=lfs -text
psycho_unity_client/Assets/Resources/PsychoLogin/*.png filter=lfs diff=lfs merge=lfs -text
necrotic_client-item_attributes/src/resources/org/necrotic/client/login_smithing_bg.png filter=lfs diff=lfs merge=lfs -text
